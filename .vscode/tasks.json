{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run NIDS app",
      "detail": "Start backend + frontend + open browser",
      "type": "shell",
      "command": "python",
      "windows": { "command": "py" },
      "args": ["run.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Backend only (requires venv)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "PYTHONUNBUFFERED": "1" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend only",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Clean (remove venv + node_modules)",
      "type": "shell",
      "command": "python",
      "windows": { "command": "py" },
      "args": [
        "-c",
        "import shutil,pathlib\nfor p in [pathlib.Path('backend/.venv'),pathlib.Path('frontend/node_modules')]:\n    if p.exists(): shutil.rmtree(p); print('removed',p)"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
