# --- NIDS backend configuration ---
APP_NAME="NIDS SIEM"
DEBUG=true

# Security
SECRET_KEY=""                  # empty = random key generated on first boot (data/.secret_key)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev; swap to Postgres for prod)
DATABASE_URL="sqlite+aiosqlite:///./nids.db"

# CORS
FRONTEND_ORIGIN="http://localhost:5173"

# Sniffer
SNIFFER_INTERFACE=""          # leave empty to use the synthetic traffic simulator
SNIFFER_BPF_FILTER=""         # e.g. "tcp or udp"
SIMULATE_TRAFFIC=true         # set false once you run with real traffic

# Demo / simulator
DEFENDED_HOST_IP="10.0.0.10"     # the host that simulated traffic targets
DEFENDED_HOST_NAME="ovidius-nids-sensor"
SIM_ATTACKS_ON_DEMAND_ONLY=true  # set false for a random attack burst every ~5 s
SIM_BENIGN_TRAFFIC=false         # set true for an always-on benign baseline (~30 pps)

# Paths
DATA_DIR="./data"
RULES_FILE="./data/rules/default_rules.yaml"
PCAP_DIR="./data/pcaps"
ML_MODEL_DIR="./data/models"

# Default admin user (created on first boot)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
